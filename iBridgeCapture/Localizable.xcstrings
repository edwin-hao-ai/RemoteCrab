        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您的 iPhone 变成 Mac 的摄像头、麦克风、触控板和键盘 —— 通过 WiFi 连接。"
          }
        }
      }
    },
