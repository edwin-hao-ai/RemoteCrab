    "We need a few permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need a few permissions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要您授予以下权限"
          }
        }
      }
    },
    "iBridge needs to use your camera, microphone, and local network. We only ever send data to your Mac — nothing leaves your WiFi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iBridge needs to use your camera, microphone, and local network. We only ever send data to your Mac — nothing leaves your WiFi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iBridge 需要使用您的相机、麦克风和本地网络。我们只会将数据发送到您的 Mac —— 数据绝不会离开您的 WiFi。"
          }
        }
      }
    },
    "Connect to your Mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接您的 Mac"
          }
        }
      }
    },
    "Download and open iBridge Receiver on your Mac, then tap Allow Permissions & Connect. They'll find each other automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and open iBridge Receiver on your Mac, then tap Allow Permissions & Connect. They'll find each other automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并在 Mac 上打开 iBridge Receiver，然后点击“允许权限并连接”。两台设备会自动找到彼此。"
          }
        }
      }
    },
    "Turn your iPhone into a camera, microphone, trackpad and keyboard for your Mac — over WiFi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your iPhone into a camera, microphone, trackpad and keyboard for your Mac — over WiFi."
