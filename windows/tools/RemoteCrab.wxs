<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteCrab for Windows — installer manifest (WiX v4).

  The install directory here is load-bearing, not cosmetic. `rc-vcam` resolves
  the COM source DLL relative to `current_exe()` and then writes that ABSOLUTE
  path into `HKLM\Software\Classes\CLSID\{9D4B0D4D-…}\InprocServer32`, comparing
  it exactly on every subsequent run. So a user who moves the install folder gets
  a virtual camera that has silently stopped being registered, and the only way
  back is another elevated registry write. Hence a fixed
  `C:\Program Files\RemoteCrab`, and an uninstall that puts the registry back the
  way it found it.

  @VERSION@ / @PAYLOAD@ are substituted by scripts/release-windows.sh, which
  also passes -d MsvcBuild=true because the payload it stages comes from the
  MSVC target.

  This file had never been compiled. Five schema errors, and one that mattered
  more than any of them: it cleaned up CLSID {8B2C4D19-…}, a GUID that appears
  nowhere in the product. The real one is `rc_vcam::win::SOURCE_CLSID`, which is
  {9D4B0D4D-1D2A-4B3E-9C0A-7F6E5D4C3B2A} — so the uninstall would have tidied a
  key that never existed and left the live camera registration exactly where it
  was, which is the one thing this manifest exists to prevent.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="RemoteCrab"
           Manufacturer="Beijing VGO Co.,Ltd"
           Version="@VERSION@"
           UpgradeCode="7C1E4B92-3A6D-4F58-9B21-0D5E8A3C7F14"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="RemoteCrab @VERSION@ — your iPhone as camera, trackpad and keyboard" />

    <!-- Windows 10 1809+. The virtual camera needs 11 22H2+, but the receiver
         itself does not, and refusing to install on 10 would be a worse answer
         than a feature that is unavailable. -->
    <Launch Condition="VersionNT64 &gt;= 10.0.17763"
            Message="RemoteCrab needs Windows 10 version 1809 or newer." />

    <!-- `afterInstallInitialize` is a WiX **v4** schedule value. The file said
         `installRemoveInitializeVersion`, which is v3: v4 does not recognise
         it, so it silently scheduled nothing and the build died with "found
         action RemoveExistingProducts with no Sequence, Before or After column
         set". There is no need to state the row by hand — <MajorUpgrade> emits
         it when the Schedule value is one it knows. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowDowngrades="no"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of RemoteCrab is already installed. Uninstall it first." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="RemoteCrab" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentGroupRef Id="VcamRegistration" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="Uninstall" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RemoteCrab" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="RemoteCrab" />
    </StandardDirectory>

    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <!-- The receiver. Not writable by the user: a modified binary loses its
           signature and Windows then refuses to load it, so an "everyone" ACL
           here is a support ticket waiting to happen. -->
      <Component Id="PayloadExe" Guid="2B8F1A44-7C03-4E91-B6D2-5A7C9E1F3B60" Directory="INSTALLFOLDER">
        <File Id="remotecrab.exe" Source="@PAYLOAD@\remotecrab.exe" KeyPath="yes" />
      </Component>

      <!-- The COM source. Must be present, or the tray's install row registers a
           DLL that does not exist and the camera silently never appears. -->
      <Component Id="PayloadDll" Guid="4C7A2E85-1B96-4D38-A0F2-9E5C3B7D1A08" Directory="INSTALLFOLDER">
        <File Id="rc_vcam_source.dll" Source="@PAYLOAD@\rc_vcam_source.dll" KeyPath="yes" />
      </Component>

      <!-- The MinGW C++ runtime, only for a GNU-target payload. The MSVC build
           does not need it — `check-windows-deps.sh` reports 19 imports and none
           of them out of the box — and shipping a second C++ runtime on a
           machine that already has a newer one is how an app causes version
           conflicts in software the user has never heard of.

           `$(MsvcBuild)` is set by release-windows.sh, which knows which target
           it staged. It was previously never set by anybody, so the manifest
           always demanded two files a MSVC payload does not contain. -->
      <?ifndef $(MsvcBuild) ?>
      <Component Id="PayloadRuntime" Guid="F1B63D09-7A24-4E85-9C70-2B48D6E9F3A5" Directory="INSTALLFOLDER">
        <File Id="libstdcxx" Source="@PAYLOAD@\libstdc++-6.dll" KeyPath="yes" />
        <File Id="libgcc" Source="@PAYLOAD@\libgcc_s_seh-1.dll" />
      </Component>
      <?endif?>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <!-- The app itself, so a fresh install is launchable without browsing to
           Program Files.

           This reverses an earlier decision whose premise did not survive
           contact: "a shortcut launches it, it appears in the notification area,
           and the user is left hunting for a window that will never open". The
           window does open — the first run raises the setup wizard, and every
           run after that shows a tray icon — so the shortcut lands the user on
           the one thing that explains the product, instead of on nothing.

           What the shortcut must not do is pretend to be a document app. It
           points straight at the exe. -->
      <Component Id="AppShortcut" Guid="A3F7C1D2-8E45-4B96-A0D3-6C29F5E8B471" Directory="ShortcutFolder">
        <Shortcut Id="AppShortcut"
                  Name="RemoteCrab"
                  Description="Use this PC's camera, microphone, trackpad and keyboard from your iPhone"
                  Target="[INSTALLFOLDER]remotecrab.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\RemoteCrab" Name="AppShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="UninstallShortcut" Guid="9D4C2E17-8B65-4A03-9F71-2C6D0E8B5A94" Directory="ShortcutFolder">
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall RemoteCrab"
                  Description="Removes RemoteCrab, its camera registration and its files"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RemoteCrab" Name="UninstallShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      The virtual camera's COM source, registered **at install time**.

      This is the step that made the product feel broken. The installer is
      perMachine, so it is already running elevated the moment it executes — and
      the one thing that genuinely needs elevation is writing HKLM. Having the
      installer sit on that privilege and then make the user open an elevated
      PowerShell to finish the job was nonsense. Register here; the camera works
      the moment the install finishes.

      HKLM rather than HKCU is not a choice. The Windows Frame Server services
      that activate a virtual camera source run as LocalService / LocalSystem
      and cannot see a per-user hive, so an HKCU registration produces a camera
      that is invisible to the very component it exists to feed.

      These three values must match `rc_vcam::win::install_source` exactly:
      the friendly name, the absolute DLL path, and `ThreadingModel = Both`.
      When the two disagree the app reports the mismatch rather than picking
      one, which is correct but unhelpful; see HANDOFF_WINDOWS_MSI.md.

      `[INSTALLFOLDER]` is a formatted field, so the MSI resolves the directory
      the user actually got. Hard-coding `C:\Program Files\RemoteCrab` here
      would be simpler and would also be a lie the moment someone installs
      elsewhere.
    -->
    <ComponentGroup Id="VcamRegistration" Directory="INSTALLFOLDER">
      <Component Id="RegisterCameraSource" Guid="8F1D4B60-3C27-4A95-B7E8-6D0A2F5C9B31" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKLM" Key="Software\Classes\CLSID\{9D4B0D4D-1D2A-4B3E-9C0A-7F6E5D4C3B2A}">
          <RegistryValue Type="string" Value="RemoteCrab Camera Source" />
          <!-- No `Root` on the nested key: WiX v4 rejects it (WIX0064). The
               hive is inherited from the parent.

               And `Key` here is **relative** — WiX appends it to the parent, so
               repeating the full path produced
               `...\CLSID\{9D4B…}\CLSID\{9D4B…}\InprocServer32`, a key that does
               not exist and never matched what the app reads. -->
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]rc_vcam_source.dll" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Both" KeyPath="yes" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Uninstall" Directory="INSTALLFOLDER">
      <!-- Everything the app wrote outside its own folder.

           The camera registration, the autostart entry and the two data folders
           are removed by **the app's own uninstall command**, run as a deferred
           elevated custom action below, rather than by a second implementation
           here. That is not tidiness: the ring file has a NULL DACL so the Frame
           Server can map it while running as LocalService, and deleting it is
           the one cleanup step a plain MSI table cannot express. The app already
           solves it. This file used to carry its own copy of the logic — with a
           CLSID that appears nowhere in the product — which is exactly how a
           wrong GUID survives review. One implementation, in the code that owns
           the problem. -->
      <Component Id="CleanupMarker" Guid="5E1A8B93-2D47-4F60-8C15-7B93E0D4A682" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\RemoteCrab" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <!-- Start at login, **on by default**.

             This is the one place the product's usefulness depends on the
             installer's choice rather than the user's. A receiver that is not
             running cannot be connected to, so an install that leaves the user
             to discover a tray toggle and then reboot has shipped a thing that
             "does not work" for everyone who skipped that step. The tray row
             turns it off again for anyone who wants that. -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="RemoteCrab" Type="string" Value="&quot;[INSTALLFOLDER]remotecrab.exe&quot;" />
        <!-- The autostart entry. No timing attribute: `RemoveRegistryValue` means
             exactly "remove this on uninstall". Writing an empty value instead
             would leave `RemoteCrab` in the Run key pointing at nothing, which
             reads to the user as "on but broken". -->
        <RemoveRegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                             Name="RemoteCrab" />
      </Component>
    </ComponentGroup>

    <!--
      Deferred and impersonating=no, so it runs as SYSTEM.

      Two reasons it is the machine-only uninstall flag and not the full one:
      under SYSTEM `%APPDATA%` resolves to the *system profile's*, so the full
      command would delete the wrong user's app data and leave the real user's
      behind — reporting success while doing nothing for the person who ran the
      uninstall. And this action must never try to raise a UAC prompt: it is
      already elevated, and a prompt inside an uninstall hangs the install.

      It is here only for the one thing an MSI table cannot express: the ring
      file's NULL DACL. The COM registration this file used to also manage is
      now written at install time (see `VcamRegistration`), so Windows Installer
      removes it by itself.

      `Return="ignore"`: if a user has already deleted the exe by hand the
      uninstall must still finish. A half-removed product sitting in Programs
      and Features is worse than a stale value the next install overwrites.
    -->
    <CustomAction Id="UninstallMachineState"
                  Directory="INSTALLFOLDER"
                  ExeCommand='"[INSTALLFOLDER]remotecrab.exe" --uninstall-vcam-machine'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      The per-user half, **impersonated**.

      This one exists because of a measured failure, not a theory. Uninstalling
      the MSI left behind:

        * `HKCU\...\CurrentVersion\Run\RemoteCrab`, pointing at an exe that no
          longer existed — the `RemoveRegistry` row for it was present in the
          table and still did not fire;
        * `%APPDATA%\RemoteCrab\`, containing `tokens.json` — the saved pairing
          token — which nothing was cleaning at all.

      The app has owned that cleanup the whole time (`remove_user_state`:
      autostart + app data). The installer just never called it. An uninstall
      that leaves a pairing token on disk is worse than one that leaves a log.

      `Impersonate` is left at its default (yes) and that is the whole point: an
      elevated install resolves `%APPDATA%` and `HKCU` to the *system profile*,
      so the machine-only action below would clean the wrong hive and the real
      user's data would survive every uninstall.
    -->
    <CustomAction Id="UninstallUserState"
                  Directory="INSTALLFOLDER"
                  ExeCommand='"[INSTALLFOLDER]remotecrab.exe" --uninstall-vcam-user'
                  Execute="deferred"
                  Return="ignore" />

    <!--
      Launch it once the install finishes, **as the user**.

      `WixShellExec` is the point: it runs the target through the shell, which
      holds the unelevated token, so the receiver starts at medium integrity.
      That matters here rather than being tidiness — the installer is perMachine
      and therefore elevated, an immediate custom action inherits that token, and
      the first version of this launched the receiver as administrator. That is
      the one configuration the product's own first-run page exists to talk
      about, and it would have shipped silently.

      `asyncNoWait` because the installer must not wait for a tray app that never
      exits. Not on uninstall, and not during the removal half of an upgrade,
      where launching would race the incoming version's files.
    -->
    <Property Id="WixShellExecTarget" Value="[#remotecrab.exe]" />
    <CustomAction Id="LaunchApp"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <!-- Both before RemoveFiles: the exe has to still be there to be run.
           User state first — it needs no rights, so a failure there cannot
           affect the machine-wide half that does. -->
      <Custom Action="UninstallUserState" Before="RemoveFiles" />
      <Custom Action="UninstallMachineState" Before="RemoveFiles" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT (REMOVE OR UPGRADINGPRODUCTCODE)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
