    "No camera permission. Enable in iOS Settings → Privacy → Camera.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera permission. Enable in iOS Settings → Privacy → Camera."
