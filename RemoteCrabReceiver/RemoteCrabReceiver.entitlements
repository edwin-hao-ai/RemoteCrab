<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      The receiver is deliberately NOT sandboxed.

      Its whole job is to drive the Mac — post CGEvent input, launch and
      terminate other apps, install the CMIO system extension. The App
      Sandbox forbids terminating other processes (NSRunningApplication
      .terminate()/.forceTerminate() return false), which silently broke
      the window picker's Quit action. The Mac app ships via Developer ID
      (not the Mac App Store), so the sandbox is optional — and the
      file/network/device entitlements below are sandbox-scoped, so they
      are dropped with it. TCC still governs camera/mic/folder access.
    -->
    <key>com.apple.developer.system-extension.install</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>5XNDF727Y6.com.remotecrab</string>
    </array>
</dict>
</plist>
