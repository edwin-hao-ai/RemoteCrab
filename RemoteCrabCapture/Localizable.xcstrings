        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误：%@"
          }
        }
      }
    },
    "Experimental gestures. Air mouse: hold the floating button on the trackpad and tilt your iPhone to move the cursor. Wheel scrolling: hold the edge button and draw circles to scroll.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental gestures. Air mouse: hold the floating button on the trackpad and tilt your iPhone to move the cursor. Wheel scrolling: hold the edge button and draw circles to scroll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性手势。空中鼠标：按住触控板上的悬浮按钮并倾斜 iPhone 来移动光标。画圈滚动：按住边缘按钮并画圈来滚动。"
          }
        }
      }
    },
    "Frame rate": {
      "extractionState": "manual",
      "localizations": {
