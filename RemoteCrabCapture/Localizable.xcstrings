    "Higher resolutions and frame rates use more WiFi bandwidth. 1080p / 30 fps is the recommended balance.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher resolutions and frame rates use more WiFi bandwidth. 1080p / 30 fps is the recommended balance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更高的分辨率和帧率会占用更多 WiFi 带宽，推荐使用 1080p / 30 fps。"
          }
        }
      }
    },
    "Hold the edge button on the trackpad and draw circles to scroll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the edge button on the trackpad and draw circles to scroll"
