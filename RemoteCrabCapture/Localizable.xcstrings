    "Hold the floating button on the trackpad and tilt your iPhone to move the cursor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the floating button on the trackpad and tilt your iPhone to move the cursor"
