    "RemoteCrab needs to use your camera, microphone, and local network. We only ever send data to your Mac — nothing leaves your WiFi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab needs to use your camera, microphone, and local network. We only ever send data to your Mac — nothing leaves your WiFi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab 需要使用您的相机、麦克风和本地网络。我们只会将数据发送到您的 Mac —— 数据绝不会离开您的 WiFi。"
          }
        }
      }
    },
