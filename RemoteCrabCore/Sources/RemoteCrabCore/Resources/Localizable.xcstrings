    "RemoteCrab installs a small camera extension so FaceTime, Zoom, Photo Booth, OBS and other apps can select “RemoteCrab Camera”. macOS asks you to approve it once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab installs a small camera extension so FaceTime, Zoom, Photo Booth, OBS and other apps can select “RemoteCrab Camera”. macOS asks you to approve it once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab 会安装一个小型相机扩展，FaceTime、Zoom、Photo Booth、OBS 等 App 即可选择「RemoteCrab Camera」。macOS 会要求你批准一次。"
          }
        }
      }
    },
