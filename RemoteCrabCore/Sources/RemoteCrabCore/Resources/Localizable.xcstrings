          "stringUnit": {
            "state": "translated",
            "value": "打开 系统设置 → 通用 → 登录项与扩展，然后在“摄像头扩展”下开启 RemoteCrab。"
          }
        }
      }
    },
    "Optional — the trackpad and keyboard work without it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional — the trackpad and keyboard work without it."
