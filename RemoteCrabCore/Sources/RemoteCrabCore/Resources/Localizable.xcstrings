    "RemoteCrab turns your iPhone's camera into a high-quality webcam for your Mac. We use it in real time — nothing is recorded or uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab turns your iPhone's camera into a high-quality webcam for your Mac. We use it in real time — nothing is recorded or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab 将你的 iPhone 摄像头变成 Mac 的高质量摄像头，实时使用，不录制、不上传。"
          }
        }
      }
    },
    "Microphone Access": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风权限"
          }
        }
      }
    },
    "RemoteCrab can stream your iPhone's microphone to your Mac. This is optional — toggle it off in the camera screen anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab can stream your iPhone's microphone to your Mac. This is optional — toggle it off in the camera screen anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab 可将 iPhone 麦克风串流到 Mac。此功能可选，随时可在相机页面关闭。"
          }
        }
      }
    },
    "Local Network Access": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Network Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络权限"
          }
        }
      }
    },
    "RemoteCrab uses Bonjour to find your Mac on the same WiFi. Without this, the two devices can't talk to each other.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab uses Bonjour to find your Mac on the same WiFi. Without this, the two devices can't talk to each other."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab 使用 Bonjour 在同一 WiFi 上查找你的 Mac。没有此权限，两台设备无法通信。"
          }
        }
      }
    },
    "Speech Recognition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech Recognition"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别"
          }
        }
      }
    },
    "Hold the voice button to dictate text into your Mac. Recognition happens on your iPhone — audio never leaves your device for this feature.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the voice button to dictate text into your Mac. Recognition happens on your iPhone — audio never leaves your device for this feature."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住语音按钮即可向 Mac 听写文字。识别在你的 iPhone 上完成——此功能的音频不会离开你的设备。"
          }
        }
      }
    },
    "Accessibility Permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility Permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限"
          }
        }
      }
    },
    "We need Accessibility to drive your Mac's cursor and keyboard from your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need Accessibility to drive your Mac's cursor and keyboard from your iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们需要辅助功能权限，才能从 iPhone 控制 Mac 的光标和键盘。"
          }
        }
      }
    },
