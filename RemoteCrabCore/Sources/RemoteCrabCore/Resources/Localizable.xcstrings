        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上下载并打开 RemoteCrab Receiver，然后点按“允许权限并连接”。两台设备会自动找到彼此。"
          }
        }
      }
    },
