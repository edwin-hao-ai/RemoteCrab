    "Turn your iPhone into a camera, microphone, trackpad and keyboard for your Mac — over WiFi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your iPhone into a camera, microphone, trackpad and keyboard for your Mac — over WiFi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的 iPhone 变成 Mac 的摄像头、麦克风、触控板和键盘 —— 通过 WiFi。"
          }
        }
      }
    },
    "We need a few permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need a few permissions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要几项权限"
          }
        }
      }
    },
    "RemoteCrab needs to use your camera, microphone, and local network. We only ever send data to your Mac — nothing leaves your WiFi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab needs to use your camera, microphone, and local network. We only ever send data to your Mac — nothing leaves your WiFi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RemoteCrab 需要使用摄像头、麦克风和本地网络。数据只会发送到你的 Mac，不会离开你的 WiFi。"
          }
        }
      }
    },
    "Connect to your Mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
