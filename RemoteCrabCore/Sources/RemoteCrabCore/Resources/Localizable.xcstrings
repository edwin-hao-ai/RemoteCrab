    },
    "Trackpad guide: drag to move the cursor; tap to click; two fingers scroll, tap for right-click, pinch to zoom; hold or double-tap and hold to drag; three-finger tap for middle-click; three or four fingers to switch; lock ⌃⌥⌘⇧ to combine them, and ⇧ to select a range.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Trackpad guide: drag to move the cursor; tap to click; two fingers scroll, tap for right-click, pinch to zoom; hold or double-tap and hold to drag; three-finger tap for middle-click; three or four fingers to switch; lock ⌃⌥⌘⇧ to combine them, and ⇧ to select a range." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "触控板指南：滑动移动光标；轻点点击；双指滚动、双指轻点右键、捏合缩放；长按或双击按住拖拽；三指轻点中键；三/四指切换；锁定 ⌃⌥⌘⇧ 组合使用，锁定 ⇧ 可框选一段。" } }
      }
    },
