    "Familiar turns your iPhone's camera into a high-quality webcam for your Mac. We use it in real time — nothing is recorded or uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiar turns your iPhone's camera into a high-quality webcam for your Mac. We use it in real time — nothing is recorded or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiar 将你的 iPhone 摄像头变成 Mac 的高质量摄像头，实时使用，不录制、不上传。"
          }
        }
      }
    },
    "Familiar can stream your iPhone's microphone to your Mac. This is optional — toggle it off in the camera screen anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiar can stream your iPhone's microphone to your Mac. This is optional — toggle it off in the camera screen anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiar 可将 iPhone 麦克风串流到 Mac。此功能可选，随时可在相机页面关闭。"
          }
        }
      }
    },
    "Familiar uses Bonjour to find your Mac on the same WiFi. Without this, the two devices can't talk to each other.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiar uses Bonjour to find your Mac on the same WiFi. Without this, the two devices can't talk to each other."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiar 使用 Bonjour 在同一 WiFi 上查找你的 Mac。没有此权限，两台设备无法通信。"
          }
        }
      }
    },
