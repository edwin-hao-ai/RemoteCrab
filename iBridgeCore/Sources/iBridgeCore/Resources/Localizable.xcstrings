    "Experimental gestures. Air mouse: hold the floating button on the trackpad and tilt your iPhone to move the cursor. Wheel scrolling: hold the edge button and draw circles to scroll.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
