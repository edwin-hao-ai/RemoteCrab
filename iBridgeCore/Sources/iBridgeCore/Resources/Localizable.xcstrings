    "Installs a small System audio driver so Zoom, QuickTime, OBS and Dictation can pick “iBridge Microphone”. Needs one admin authorization; audio briefly restarts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
